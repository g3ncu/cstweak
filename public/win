    @{Name="vmickvpexchange"; Type="Manual"}, @{Name="vmicrdv"; Type="Manual"}, @{Name="vmicshutdown"; Type="Manual"},
    @{Name="vmictimesync"; Type="Manual"}, @{Name="vmicvmsession"; Type="Manual"}, @{Name="vmicvss"; Type="Manual"},
    @{Name="vmvss"; Type="Manual"}, @{Name="wbengine"; Type="Manual"}, @{Name="wcncsvc"; Type="Manual"},
    @{Name="webthreatdefsvc"; Type="Manual"}, @{Name="wercplsupport"; Type="Manual"}, @{Name="wisvc"; Type="Manual"},
    @{Name="wlidsvc"; Type="Manual"}, @{Name="wlpasvc"; Type="Manual"}, @{Name="wmiApSrv"; Type="Manual"},
    @{Name="workfolderssvc"; Type="Manual"}, @{Name="wscsvc"; Type="AutomaticDelayedStart"}, @{Name="wuauserv"; Type="Manual"},
    @{Name="wudfsvc"; Type="Manual"}
)

foreach ($srv in $ServiceConfig) {
    try {
        $serviceObj = Get-Service -Name $srv.Name -ErrorAction SilentlyContinue
        if ($serviceObj) {
            Set-Service -Name $srv.Name -StartupType $srv.Type -ErrorAction SilentlyContinue
            if ($srv.Type -eq "Disabled" -and $serviceObj.Status -eq "Running") {
                Stop-Service -Name $srv.Name -Force -ErrorAction SilentlyContinue
            }
        }
    }
    catch {}
}
Write-Host "   Servisler yapilandirildi." -ForegroundColor Green

# =============================================================================
# 10. OneDrive Kaldirma
# =============================================================================
Write-Host "`n10. OneDrive Temizligi..." -ForegroundColor Yellow
try {
    taskkill.exe /F /IM OneDrive.exe /T > $null 2>&1
    $OneDriveSetup = "$env:SystemRoot\System32\OneDriveSetup.exe"
    if (Test-Path $OneDriveSetup) {
        Start-Process $OneDriveSetup -ArgumentList "/uninstall /silent /force" -Wait
    }
    Remove-Item -Path "HKCU:\Software\Microsoft\OneDrive" -Recurse -Force -ErrorAction SilentlyContinue
    Write-Host "   OneDrive temizlendi." -ForegroundColor Green
}
catch {
    Write-Host "   OneDrive Hatasi." -ForegroundColor Red
}

# =============================================================================
# 11. HAGS (Donanim Hizlandirmali GPU Zamanlamasi)
# =============================================================================
Write-Host "`n11. HAGS (GPU Zamanlamasi) aciliyor..." -ForegroundColor Yellow
try {
    $HagsPath = "HKLM:\SYSTEM\CurrentControlSet\Control\GraphicsDrivers"
    
    # Eger yol yoksa olustur
    if (!(Test-Path $HagsPath)) { 
        New-Item -Path $HagsPath -Force | Out-Null 
    }

    # HwSchMode: 2 = Acik (On), 1 = Kapali (Off)
    Set-ItemProperty -Path $HagsPath -Name "HwSchMode" -Value 2 -Type DWord -Force -ErrorAction Stop
    
    Write-Host "   HAGS acildi (%1 Low FPS stabilizasyonu icin - Etki icin Restart sart)." -ForegroundColor Green
}
catch {
    Write-Host "   HAGS ayari uygulanamadi." -ForegroundColor Red
}

# =============================================================================
# 12. Windows 11 Gecikme & Ekstra Sistem Ayarlari
# =============================================================================
Write-Host "`n12. Windows 11 Gecikme & Ekstra Sistem Ayarlari..." -ForegroundColor Yellow
try {
    # Platform Zamanlayici Kilidini Acma (Micro-Stutter Cozumu)
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\kernel" -Name "GlobalTimerResolutionRequests" -Value 1 -Type DWord -Force
    
    # Windows NDU Servisini Kapatma (Gizli Ag Verisi Toplama ve Bellek Sizintisi Onleme)
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\Ndu" -Name "Start" -Value 4 -Type DWord -Force
    
    # Telemetri ve Veri Toplamayi Durdurma (DiagTrack)
    $DiagTrackService = Get-Service -Name "DiagTrack" -ErrorAction SilentlyContinue
    if ($DiagTrackService) {
        Set-Service -Name "DiagTrack" -StartupType Disabled -ErrorAction SilentlyContinue
        if ($DiagTrackService.Status -eq "Running") {
            Stop-Service -Name "DiagTrack" -Force -ErrorAction SilentlyContinue
        }
    }
    Write-Host "   Ekstra Windows 11 gecikme ve telemetri ayarlari tamamlandi." -ForegroundColor Green
}
catch {
    Write-Host "   Ekstra ayarlar uygulanirken bir hata olustu." -ForegroundColor Red
}

# =============================================================================
# 13. Ses Gelistirmelerini Kapatma (Disable All Enhancements)
# =============================================================================
Write-Host "`n13. Ses cihazlari icin gelistirmeler devre disi birakiliyor..." -ForegroundColor Yellow
try {
    # Windows'taki tum ses cikis (Render) cihazlarinin bulundugu dizin
    $RenderDevicesPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render"
    
    if (Test-Path $RenderDevicesPath) {
        $AudioDevices = Get-ChildItem -Path $RenderDevicesPath
        
        # Her bir cihazin (kulaklik/hoparlor vb.) icine tek tek gir
        foreach ($Device in $AudioDevices) {
            $FxPropertiesPath = "$($Device.PSPath)\FxProperties"
            
            if (Test-Path $FxPropertiesPath) {
                # '{1da5d803-d492-4edd-8c23-e0c0ffee7f0e},5' anahtari Disable all enhancements kutusunu temsil eder
                # Degeri 1 yapmak kutuyu isaretler (Gelistirmeleri devre disi birakir)
                New-ItemProperty -Path $FxPropertiesPath -Name "{1da5d803-d492-4edd-8c23-e0c0ffee7f0e},5" -Value 1 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null
            }
        }
        Write-Host "   Tum ses cihazlari icin gelistirmeler kapatildi (audiodg.exe yuku hafifletildi)." -ForegroundColor Green
    }
}
catch {
    Write-Host "   Ses ayarlari uygulanirken bir hata olustu." -ForegroundColor Red
}

