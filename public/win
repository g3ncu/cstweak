Write-Host "`n==================================================================" -ForegroundColor Cyan
Write-Host " GENCUEZ (CS2 LOW LATENCY EDITION) TAMAMLANDI" -ForegroundColor Green
Write-Host "==================================================================" -ForegroundColor Cyan
Write-Host " Tum servisler ve O&O ayarlari islendi." -ForegroundColor Yellow
Write-Host " Lutfen bilgisayari YENIDEN BASLATIN." -ForegroundColor Yellow
Write-Host "==================================================================" -ForegroundColor Cyan

$Restart = Read-Host "`n Simdi yeniden baslatilsin mi? (E/H)"
if ($Restart -eq 'E' -or $Restart -eq 'e') {
    Restart-Computer -Force
}
else {
    Write-Host "   Cikis icin bir tusa basin..."
    [Console]::ReadKey($true) | Out-Null
    Exit
}